# New run outputs (results/) are not tracked. The released networks and
# trajectories under data/ and the reference outputs of the paper's run
# under paper_results/ are (see their README files).
/data/*
!/data/README.md
!/data/LICENSE
!/data/SOURCES.json
!/data/datapackage.json
!/data/graphs/
/data/graphs/*
!/data/graphs/step01_*_unified.graphml
!/data/trajectories/
/data/trajectories/*
!/data/trajectories/step03_*_trajectories_v5.csv
/results/
/Roads/
/downloaded_papers/
/cache/
/.cache/

# LaTeX build files
*.tex
*.aux
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.cls
/figures/
/build/

# Local notes and scripts
*.md
!README.md
*.sh

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Editor / OS
.vscode/
.DS_Store
.tectonic-cache/
tools/
